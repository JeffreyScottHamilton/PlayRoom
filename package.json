{
  "name": "playroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ruffle.mjs && node scripts/validate-games.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ruffle.mjs && node scripts/validate-games.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/PlayRoom/ VITE_LIBRARY=open npm run build && VITE_LIBRARY=open node scripts/postbuild-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "node scripts/validate-games.mjs",
    "import": "node scripts/import-games.mjs",
    "lint": "oxlint",
    "e2e": "npm run build && node e2e/player.spec.mjs && npm run e2e:game && npm run e2e:html5",
    "e2e:game": "node e2e/game-page.spec.mjs",
    "e2e:html5": "node e2e/html5.spec.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@ruffle-rs/ruffle": "0.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
